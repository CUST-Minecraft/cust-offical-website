{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Setting",
    "description": "Global website identity, navigation, SEO, and footer foundation."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "shortName": {
      "type": "string",
      "required": true
    },
    "englishName": {
      "type": "string",
      "required": true
    },
    "logoText": {
      "type": "string",
      "required": true
    },
    "logoImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "text"
    },
    "copyright": {
      "type": "text",
      "required": true
    },
    "credit": {
      "type": "string",
      "required": true
    },
    "footerAboutLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.footer-link"
    },
    "navigation": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-link",
      "required": true
    }
  }
}
